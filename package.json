{
  "name": "@zoux/exemplar-design-system",
  "private": true,
  "version": "0.1.0",
  "description": "Shared tokens, fonts and React components for our Open edX exemplar blocks, generated from the Exemplars-System Figma file.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.scss": "./src/styles.scss"
  },
  "files": ["src", "tokens"],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run tokens && tsc --noEmit && vite build"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@fontsource/lato": "^5.1.0",
    "@fontsource/sora": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.77.6",
    "typescript": "^5.6.3",
    "vite": "^5.3.1"
  }
}
